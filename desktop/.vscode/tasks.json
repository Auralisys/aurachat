{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AuraChat: dev",
      "type": "shell",
      "command": "cargo tauri dev",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "AuraChat: build",
      "type": "shell",
      "command": "cargo tauri build",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
