{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuraChat",
  "version": "0.1.0",
  "identifier": "dev.aurachat.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AuraChat",
        "width": 480,
        "height": 320,
        "minWidth": 480,
        "minHeight": 320,
        "center": true,
        "resizable": false,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "windows": { "nsis": { "installerHooks": "windows-runtime.nsh" } },
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/windows/32x32.png",
      "icons/windows/128x128.png",
      "icons/windows/128x128@2x.png",
      "icons/windows/icon.ico"
    ]
  }
}
